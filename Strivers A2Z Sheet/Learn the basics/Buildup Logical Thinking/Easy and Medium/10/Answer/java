class Solution {
    public void pattern10(int n) {
        for(int z = 1; z <= n; z++){
            for(int i = 0; i < z; i++){
                System.out.print("*");
            }
            System.out.print("\n");
        }

        for(int z = 1; z <= n; z++){
            for(int i = n - z; i < z; i--){
                System.out.print("*");
            }
            System.out.print("\n");
        }
    }
}
